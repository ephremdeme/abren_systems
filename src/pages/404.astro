---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Page not found — Abren Systems" noindex>
  <Header />
  <main>
    <section class="hero" aria-label="Page not found">
      <p class="identity">
        <span>404</span><span aria-hidden="true">·</span><span>Not found</span>
      </p>
      <h1>There is nothing at this address.</h1>
      <p class="hero-lede">The page may have moved, or the link may be mistyped.</p>
      <p class="back"><a href="/">Back to the front page <span class="arrow" aria-hidden="true">→</span></a></p>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  section {
    padding-bottom: clamp(96px, 10vw, 140px);
  }

  .back {
    margin: 48px 0 0;
    font-size: 16px;
  }

  .back a {
    display: inline-flex;
    gap: 8px;
    align-items: center;
  }
</style>
